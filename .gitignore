# ============================================================
# 变化检测大屏平台 · 版本控制忽略清单
#
# 本仓库只收录「源码 + 配置模板 + 文档」；
# 运行期产生的数据、依赖、构建产物一律不入库。
# 各服务启动时会自动创建所需的数据目录，无需预先提交空目录。
# ============================================================

# ---------- 运行期数据（严禁入库） ----------
# Go 业务层数据根目录：影像、结果、Wayback 共享目录、SQLite 元数据库
backend-go/data/
# Python 计算层的本地测试输出（生产输出目录由 Go 通过 output_dir 传入）
backend-py/data/

# 项目级运行目录。首次启动会自动创建，源码发布不需要提交空目录。
data/cache/
data/logs/
data/validation/
data/imagery/

# 本机模型权重保留用于运行，但通过独立制品交付，不提交到 GitHub。
model-runtime/model/*.onnx

# 影像与结果的常见扩展名兜底（防止误放到源码目录）
*.tif
*.tiff
*.geojson
*.gpkg
*.shp
*.shx
*.dbf

# ---------- 机密与环境变量（严禁入库） ----------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ---------- Node / 前端 ----------
node_modules/
frontend/dist/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache
.stylelintcache
*.tsbuildinfo

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
*.egg-info/
.eggs/

# 虚拟环境（本地各自重建，不入库）
.venv/
.venv-*/
venv/
ENV/
env/

# Python 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/

# ---------- Go ----------
# 编译产物
backend-go/backend-go
backend-go/backend-go.exe
*.exe
bin/

# Go 测试与覆盖率产物
*.test
*.out
coverage.txt

# ---------- 日志 ----------
logs/
*.log

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- 临时 / 备份文件 ----------
*.bak
*.tmp
*.temp
*.old
*.orig
*~
*_BACKUP_*

# ---------- AI / 工具链工作目录 ----------
.trae/
.cursor/
.agents/
.omo/

# Local test output and caches
.cache/
.pip-cache/
.npm-cache/
*.ovr
data/imagery/*.aux
data/imagery/*.rrd
data/imagery/*.rde
data/imagery/*.enp
!data/boundaries/*.geojson

# Python/Go 本地构建缓存
backend-go/.cache/
*.prof

# Environment export and migration backups
deploy/environment-images.tar
*.pre-migration
