{
  "name": "change-detection-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "format:management": "prettier --write src/views/Management.vue src/utils/settings.ts src/components/AlgorithmForm.vue",
    "format:check": "prettier --check src/views/Management.vue src/utils/settings.ts src/components/AlgorithmForm.vue"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "echarts": "6.1.0",
    "leaflet": "^1.9.4",
    "polygon-clipping": "^0.15.7",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "6.4.4",
    "vue-tsc": "^2.0.0"
  }
}
